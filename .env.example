# Claude API キー（設定すると高精度な AI 分析が有効になります。未設定でもルールベースで動作します）
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 使用する Claude モデル（任意。未指定なら claude-opus-4-8）
# 例: 低コスト・低レイテンシ重視なら claude-sonnet-4-6
ANTHROPIC_MODEL=claude-opus-4-8

# Slack 社内検索（任意。設定すると社内情報検索がモックから実 Slack 検索に切り替わります）
# 取得手順は README の「社内情報検索（Slack 連携）」を参照（ユーザートークン xoxp、スコープ search:read）
SLACK_USER_TOKEN=xoxp-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DM・プライベートチャンネルも検索結果に含める（既定は public チャンネル限定。
# 画面共有中に DM の断片が表示される事故を防ぐため、通常は設定しないこと）
# SLACK_INCLUDE_PRIVATE=1
